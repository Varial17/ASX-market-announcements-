# Copy to .dev.vars (gitignored) for `wrangler dev`.
# In production these are set with `wrangler secret put <NAME>`.

ANTHROPIC_API_KEY=sk-ant-...

# Public token lifted from the ASX site's own JavaScript. Expect rotation
# without notice — the poller alerts loudly on a 401/403 rather than failing
# silently.
ASX_ACCESS_TOKEN=83ff96335c2d45a094df02a206a39ff4

# Optional. Slack or Discord incoming webhook for the staleness watchdog.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
